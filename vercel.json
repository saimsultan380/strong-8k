{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.strong-8k.co.uk" }],
      "destination": "https://strong-8k.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/free-trial",
      "destination": "/contact-us/",
      "permanent": true
    },
    {
      "source": "/free-trial/",
      "destination": "/contact-us/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact-us/",
      "permanent": true
    }
  ]
}
